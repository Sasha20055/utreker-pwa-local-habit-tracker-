# OAuth 2.0 Client ID для синхронизации с Google Drive.
# Это публичное значение (не секрет): для браузерных приложений Google
# защищает его через список Authorized JavaScript origins, а не секретностью.
#
# Где взять — см. Readme.md, раздел "Google Drive Sync".
# Для локальной разработки скопируйте этот файл в .env.local и подставьте свой ID.
VITE_GOOGLE_CLIENT_ID=
